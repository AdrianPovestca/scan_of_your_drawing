{
  "name": "scan-of-your-drawing",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "ai": { "binding": "AI" },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/transform"]
  },
  "ratelimits": [
    { "name": "LIMITER", "namespace_id": "1001", "simple": { "limit": 4, "period": 60 } }
  ],
  "observability": { "enabled": true }
}